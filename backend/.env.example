DEBUG=1
SECRET_KEY=ganti-dengan-hasil-perintah-di-bawah
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# python -c "import secrets; print(secrets.token_urlsafe(50))"

# Kosongkan blok DB_* di bawah untuk memakai SQLite (cukup untuk uji coba cepat).
# Isi untuk memakai PostgreSQL (disarankan, termasuk untuk pengembangan lokal).
DB_NAME=simonda
DB_USER=simonda
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Produksi (Render + Neon + Cloudflare R2) ---
# Isi DATABASE_URL untuk pakai Postgres terkelola (mis. Neon); mengalahkan
# blok DB_* di atas kalau diisi. Format: postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=

# Isi kelima variabel R2 ini untuk memakai Cloudflare R2 sebagai penyimpanan
# berkas bukti dukung (wajib di produksi -- disk Render tidak permanen).
# Kosongkan semua untuk tetap pakai folder lokal backend/media/ (dev).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
